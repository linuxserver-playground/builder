{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://linuxserver-playground.github.io/builder/schemas/mod.schema.json",
  "title": "Docker Mod manifest (mod.yml)",
  "description": "One per mod branch in docker-mods. The hub indexes every branch's mod.yml to build the mods API and site.",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema", "name", "target", "summary", "maintainers"],
  "properties": {
    "schema": { "const": 1 },
    "name": { "type": "string", "pattern": "^[a-z0-9][a-z0-9-]*$", "description": "Mod name without the image prefix, e.g. 'python3'." },
    "target": { "type": "string", "pattern": "^[a-z0-9][a-z0-9-]*$", "description": "Image the mod applies to, or 'universal'." },
    "title": { "type": "string" },
    "summary": { "type": "string", "minLength": 10 },
    "maintainers": { "type": "array", "minItems": 1, "items": { "type": "string", "description": "GitHub login" } },
    "platforms": { "type": "array", "items": { "enum": ["amd64", "arm64"] }, "default": ["amd64", "arm64"] },
    "bases": { "type": "array", "items": { "enum": ["alpine", "ubuntu", "debian", "fedora", "arch", "el"] }, "description": "Base families the mod handles; universal mods usually list alpine and ubuntu." },
    "env": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["name", "description"],
        "properties": {
          "name": { "type": "string", "pattern": "^[A-Z][A-Z0-9_]*$" },
          "description": { "type": "string" },
          "default": { "type": "string" },
          "required": { "type": "boolean", "default": false }
        }
      }
    },
    "version": {
      "description": "Optional upstream version source for mods that pin a tool version (sets MOD_VERSION).",
      "$ref": "image.schema.json#/$defs/version_source"
    },
    "deprecated": {
      "type": "object",
      "additionalProperties": false,
      "required": ["status"],
      "properties": { "status": { "type": "boolean" }, "message": { "type": "string" } }
    },
    "docs": { "type": "string", "description": "Longer Markdown; the README body." }
  }
}
