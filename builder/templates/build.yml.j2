# Generated by builder from image.yml. Do not edit; the shared workflow rewrites this file.
# Every build of this repository runs {{ pipeline_org }}/workflows image-build.yml@v1.

name: Build

on:
  push:
    branches: ["**"]
    tags-ignore: ["**"]
  pull_request:
    types: [opened, synchronize, reopened]
  workflow_dispatch:
    inputs:
      reason:
        description: Why this build runs
        type: choice
        options: [manual, upstream, packages, rebuild, pages]
        default: manual
  repository_dispatch:
    types: [build]

concurrency:
  group: build-${{ '{{' }} github.ref {{ '}}' }}${{ '{{' }} (github.event.inputs.reason || github.event.client_payload.reason) == 'pages' && '-pages' || '' {{ '}}' }}
  cancel-in-progress: ${{ '{{' }} github.event_name == 'pull_request' {{ '}}' }}

jobs:
  build:
    uses: {{ pipeline_org }}/workflows/.github/workflows/image-build.yml@v1
    permissions:
      contents: write
      packages: write
      actions: write
      pull-requests: write
      id-token: write
      attestations: write
      pages: write
    with:
      reason: ${{ '{{' }} github.event.inputs.reason || github.event.client_payload.reason || 'push' {{ '}}' }}
      workflows_ref: v1
    # Named, not `inherit`: GitHub passes inherited secrets only to a workflow in the same organisation, and the
    # shared workflows may live in another (a Labs image calls the main org's).
    secrets:
      CONTROL_URL: ${{ '{{' }} secrets.CONTROL_URL {{ '}}' }}
      CONTROL_EVENTS_SECRET: ${{ '{{' }} secrets.CONTROL_EVENTS_SECRET {{ '}}' }}
      ATTACHMENTS_TOKEN: ${{ '{{' }} secrets.ATTACHMENTS_TOKEN {{ '}}' }}
